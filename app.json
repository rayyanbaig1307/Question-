{
  "expo": {
    "name": "Peekaboo",
    "slug": "peekaboo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "peekaboo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rbaig18.peekaboo",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.rbaig18.peekaboo",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Peekaboo uses your camera to take photos and videos for your friends, and for face filters like googly eyes.",
          "microphonePermission": "Peekaboo uses your microphone to record sound for your videos and to send voice notes.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Peekaboo lets you pick photos and videos to share, or a picture for your profile or a group.",
          "cameraPermission": "Peekaboo uses your camera to take photos and videos for your friends, and for face filters like googly eyes.",
          "microphonePermission": "Peekaboo uses your microphone to record sound for your videos and to send voice notes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Peekaboo shows your spot to your friends on the friend map, only when you turn location sharing on.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4F9A",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Peekaboo uses your microphone to record sound for your videos and to send voice notes."
        }
      ],
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Peekaboo lets you pick photos and videos to share, or a picture for your profile or a group.",
          "savePhotosPermission": "Peekaboo saves the photos and videos you keep to your Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-apple-authentication",
      [
        "./plugins/with-ios-app-icons.js",
        [
          { "name": "DarkGold", "ios": "./assets/icons/dark-gold.png" },
          { "name": "Midnight", "ios": "./assets/icons/midnight.png" },
          { "name": "Mint", "ios": "./assets/icons/mint.png" },
          { "name": "Sunny", "ios": "./assets/icons/sunny.png" },
          { "name": "CleanWhite", "ios": "./assets/icons/clean-white.png" },
          { "name": "AllBlack", "ios": "./assets/icons/all-black.png" },
          { "name": "Cherry", "ios": "./assets/icons/cherry.png" },
          { "name": "FxSunset", "ios": "./assets/icons/fx-sunset.png" },
          { "name": "FxAurora", "ios": "./assets/icons/fx-aurora.png" },
          { "name": "FxHolo", "ios": "./assets/icons/fx-holo.png" },
          { "name": "FxNeon", "ios": "./assets/icons/fx-neon.png" },
          { "name": "FxOcean", "ios": "./assets/icons/fx-ocean.png" },
          { "name": "FxGlitterGold", "ios": "./assets/icons/fx-glitter-gold.png" },
          { "name": "FxCandy", "ios": "./assets/icons/fx-candy.png" },
          { "name": "FxGalaxy", "ios": "./assets/icons/fx-galaxy.png" }
        ]
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "rbaig18s-team",
    "extra": {
      "eas": {
        "projectId": "3c421eae-c4ec-47ea-92da-4b2d07b7d13e"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c421eae-c4ec-47ea-92da-4b2d07b7d13e"
    }
  }
}
