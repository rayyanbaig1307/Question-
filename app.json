{
  "expo": {
    "name": "Peekaboo",
    "slug": "peekaboo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "peekaboo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rbaig18.peekaboo"
    },
    "android": {
      "package": "com.rbaig18.peekaboo",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Peekaboo uses your camera so you can take photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Peekaboo lets you pick photos to post or use as your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Peekaboo shows your spot to your friends on the friend map, only when you turn location sharing on.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4F9A"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "rbaig18s-team",
    "extra": {
      "eas": {
        "projectId": "3c421eae-c4ec-47ea-92da-4b2d07b7d13e"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c421eae-c4ec-47ea-92da-4b2d07b7d13e"
    }
  }
}
