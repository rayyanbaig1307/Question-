{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    },
    "testflight": {
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "distribution": "store"
    },
    "testflight-testing": {
      "extends": "testflight",
      "channel": "testing"
    },
    "preview-testing": {
      "extends": "preview",
      "channel": "testing"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6829561855"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6829561855"
      }
    },
    "testflight-testing": {
      "ios": {
        "ascAppId": "6829561855"
      }
    }
  }
}
