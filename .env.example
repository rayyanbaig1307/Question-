# Copy this file to ".env" and paste your Supabase details.
# Find them in Supabase: Project Settings -> API (or the "Connect" button).
# Both values are safe to put in a phone app – your data is protected by the
# privacy rules in supabase/migrations.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Sign in with Google (Android). The "Web client ID" from Google Cloud → APIs & Services → Credentials.
# Not a secret – it is built into every copy of the app. Leave it empty and the Google button is hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
