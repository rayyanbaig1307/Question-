{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["peekaboo", "facemesh"],
  "ios": {
    "iosModuleName": "PeekabooFaceMesh"
  },
  "android": {
    "androidNamespace": ["peekaboo", "facemesh"],
    "androidCxxLibName": "PeekabooFaceMesh"
  },
  "autolinking": {
    "FaceMeshFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFaceMeshFactory"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFaceMeshFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
