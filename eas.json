{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    },
    "testflight": {
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "distribution": "store"
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "FILL_IN_FROM_APP_STORE_CONNECT"
      }
    }
  }
}
